# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
PORT=3000
BASE_URL=https://adplatform.com

# ============================================
# SITE IDENTITY & SEO
# ============================================
SITE_NAME=AdPlatform
SITE_URL=https://adplatform.com
SITE_DESCRIPTION=AdPlatform helps Nigerian businesses create and manage online advertising campaigns with secure payments and administrator approval across TikTok, Instagram, and Google.

# ============================================
# BUSINESS INFORMATION
# ============================================
BUSINESS_NAME=AdPlatform Digital Media Limited
BUSINESS_EMAIL=support@adplatform.com
BUSINESS_PHONE=+2348000000000
BUSINESS_ADDRESS=Lagos, Nigeria
BUSINESS_LOGO_URL=https://adplatform.com/logo.png

# Social Media URLs
FACEBOOK_URL=https://facebook.com/adplatform
TWITTER_URL=https://twitter.com/adplatform
LINKEDIN_URL=https://linkedin.com/company/adplatform
INSTAGRAM_URL=https://instagram.com/adplatform

# ============================================
# SEARCH ENGINE VERIFICATION
# ============================================
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/adplatform

# ============================================
# SESSION & SECURITY
# ============================================
SESSION_SECRET=change-this-to-a-strong-random-string-in-production
CSRF_SECRET=change-this-to-a-strong-random-string-in-production

# ============================================
# PAYMENT GATEWAY (PAYSTACK)
# ============================================
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxx
PAYSTACK_CALLBACK_URL=https://adplatform.com/payments/callback
DEMO_MODE=false
DEMO_PAYMENTS=false

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@adplatform.com
SMTP_FROM_NAME=AdPlatform

# ============================================
# ADMIN ACCOUNT SETUP
# ============================================
ADMIN_EMAIL=admin@adplatform.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_FULLNAME=Platform Administrator
ADMIN_PHONE=+2348000000000
ADMIN_SETUP_SECRET=adplatform_secret_setup_key_2026

# ============================================
# PLATFORM CONFIGURATION
# ============================================
EXCHANGE_RATE_USD_TO_NGN=1600
TIKTOK_SERVICE_FEE=20000
INSTAGRAM_SERVICE_FEE=15000
GOOGLE_SERVICE_FEE=20000
CAMPAIGN_APPROVAL_DAYS=2
MAX_UPLOAD_SIZE_MB=50

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
SENTRY_DSN=

# ============================================
# OPTIONAL: AI/CRAWLER METADATA
# ============================================
# Set to 'true' if you want to allow AI crawlers to index your site
ALLOW_AI_CRAWLERS=true
