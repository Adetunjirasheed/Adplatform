<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Reset Password | AdPlatform</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <% if (typeof demoMode !== 'undefined' && demoMode) { %>
    <div class="demo-banner">⚠️ DEMO MODE ACTIVE — Safe local development testing.</div>
  <% } %>
  <%- include('../partials/flash') %>

  <main class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <h1 class="auth-title">Forgot Password</h1>
        <p class="auth-subtitle">Enter your registered business email and we'll send you recovery instructions.</p>
      </div>

      <form action="/auth/forgot-password" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="email" class="form-label">Business Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            required
            placeholder="business@example.com"
          >
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 15px;">
          Send Reset Instructions
        </button>
      </form>

      <div class="auth-footer">
        <p>Remembered your password? <a href="/auth/login" class="auth-link">Back to Login</a></p>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>

