<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Admin Portal Access | AdPlatform</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body style="background: #0f172a; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;">
  <div style="width: 100%; max-width: 440px; background: #1e293b; border-radius: 12px; padding: 35px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); color: #f8fafc; border: 1px solid #334155;">
    <div style="text-align: center; margin-bottom: 30px;">
      <div style="font-size: 32px; margin-bottom: 8px;">🛡️</div>
      <h1 style="font-size: 24px; margin: 0; color: #ffffff;">Platform Control Center</h1>
      <p style="color: #94a3b8; font-size: 13px; margin-top: 5px;">Restricted administrative authentication required</p>
    </div>

    <%- include('../partials/flash') %>

    <form action="/auth/admin/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group" style="margin-bottom: 20px;">
        <label for="email" class="form-label" style="color: #cbd5e1;">Administrator Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-control"
          required
          style="background: #0f172a; border-color: #334155; color: #fff;"
          placeholder="e.g. admin@yourbusiness.com"
          value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
        >

      </div>

      <div class="form-group" style="margin-bottom: 25px;">
        <label for="password" class="form-label" style="color: #cbd5e1;">Secure Password</label>
        <input
          type="password"
          id="password"
          name="password"
          class="form-control"
          required
          style="background: #0f172a; border-color: #334155; color: #fff;"
          placeholder="••••••••••••"
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg" style="background: #3b82f6; font-size: 16px;">
        Verify Admin Credentials
      </button>
    </form>

    <div style="text-align: center; margin-top: 25px; font-size: 12px; color: #64748b;">
      <a href="/" style="color: #94a3b8; text-decoration: none;">&larr; Return to Public Website</a>
    </div>
  </div>
</body>
</html>

