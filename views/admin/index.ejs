<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Administrator Control Center | AdPlatform</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <% if (typeof demoMode !== 'undefined' && demoMode) { %>
    <div class="demo-banner">⚠️ DEMO MODE ACTIVE — Financial stats reflect test transactions.</div>
  <% } %>

  <div class="admin-layout">
    <!-- Admin Sidebar Navigation -->
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-brand">
        <span class="brand-accent">Ad</span>Platform <span class="badge badge-primary" style="font-size: 10px;">Admin</span>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin" class="nav-item active">📊 Dashboard</a>
        <a href="/admin/users" class="nav-item">👥 Users</a>
        <a href="/admin/campaigns" class="nav-item">📢 Campaigns</a>
        <a href="/admin/payments" class="nav-item">💳 Payments</a>
        <a href="/admin/settings" class="nav-item">⚙️ Settings</a>
        <a href="/admin/support" class="nav-item">🎧 Support Desk</a>
        <hr style="border: 0; border-top: 1px solid #334155; margin: 15px 0;">
        <a href="/dashboard" class="nav-item">👁️ Client View</a>
        <a href="/auth/logout" class="nav-item" style="color: #ef4444;">🚪 Logout</a>
      </nav>
    </aside>

    <!-- Main Content Panel -->
    <main class="admin-main">
      <header class="admin-topbar">
        <div style="display: flex; align-items: center; gap: 15px;">
          <button class="btn btn-outline btn-sm admin-toggle-sidebar" id="sidebarToggleBtn">☰</button>
          <h2 style="margin: 0; font-size: 20px;">Financial & Operations Overview</h2>
        </div>
        <div>
          <span style="font-size: 13px; color: var(--color-muted);">Admin: <%= user.fullName %> (<%= user.businessEmail %>)</span>
        </div>
      </header>

      <%- include('../partials/flash') %>

      <div class="admin-content-inner">
        <!-- Financial Overview Cards -->
        <h3 style="margin: 0 0 15px 0; font-size: 16px; color: var(--color-muted); text-transform: uppercase;">
          Revenue & Margin Breakdown
        </h3>
        <div class="admin-stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 25px;">
          <div class="card stat-card border-primary">
            <div class="card-body">
              <div class="stat-card-title">Total Processed Revenue</div>
              <div class="stat-card-value" style="color: var(--color-primary);">₦<%= Number(stats.totalRevenue).toLocaleString() %></div>
              <div class="stat-card-hint">All verified payments</div>
            </div>
          </div>

          <div class="card stat-card border-blue">
            <div class="card-body">
              <div class="stat-card-title">Allocated Ad Spend</div>
              <div class="stat-card-value">₦<%= Number(stats.totalAdBudget).toLocaleString() %></div>
              <div class="stat-card-hint">Disbursed to networks</div>
            </div>
          </div>

          <div class="card stat-card border-green">
            <div class="card-body">
              <div class="stat-card-title" style="color: var(--color-success);">Platform Profit / Fees</div>
              <div class="stat-card-value" style="color: var(--color-success);">₦<%= Number(stats.totalServiceFeeRevenue).toLocaleString() %></div>
              <div class="stat-card-hint">AdPlatform net earned margin</div>
            </div>
          </div>

          <div class="card stat-card border-orange">
            <div class="card-body">
              <div class="stat-card-title">Today's Settlements</div>
              <div class="stat-card-value">₦<%= Number(stats.todayRevenue).toLocaleString() %></div>
              <div class="stat-card-hint">This week: ₦<%= Number(stats.weekRevenue).toLocaleString() %></div>
            </div>
          </div>
        </div>

        <!-- Operational Counts Grid -->
        <div class="admin-stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin-bottom: 30px;">
          <div class="card">
            <div class="card-body">
              <div class="stat-card-title">Total Customers</div>
              <div style="font-size: 24px; font-weight: bold;"><%= stats.totalUsers %></div>
            </div>
          </div>

          <div class="card">
            <div class="card-body">
              <div class="stat-card-title">Total Campaigns</div>
              <div style="font-size: 24px; font-weight: bold;"><%= stats.totalCampaigns %></div>
            </div>
          </div>

          <div class="card">
            <div class="card-body">
              <div class="stat-card-title" style="color: var(--color-success);">Running Campaigns</div>
              <div style="font-size: 24px; font-weight: bold; color: var(--color-success);"><%= stats.activeCampaigns %></div>
            </div>
          </div>

          <div class="card">
            <div class="card-body">
              <div class="stat-card-title" style="color: var(--color-warning);">Pending Review/Pay</div>
              <div style="font-size: 24px; font-weight: bold; color: var(--color-warning);"><%= stats.pendingCampaigns %></div>
            </div>
          </div>

          <div class="card">
            <div class="card-body">
              <div class="stat-card-title">Completed Schedules</div>
              <div style="font-size: 24px; font-weight: bold;"><%= stats.completedCampaigns %></div>
            </div>
          </div>
        </div>

        <!-- Network Revenue Breakdown -->
        <div class="card" style="margin-bottom: 30px;">
          <div class="card-header">
            <h3>Revenue by Advertising Channel</h3>
          </div>
          <div class="card-body">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
              <div style="padding: 15px; background: #f8fafc; border-radius: 8px; border-left: 4px solid #000;">
                <h4 style="margin: 0 0 5px 0;">🎵 TikTok Ads</h4>
                <div style="font-size: 20px; font-weight: bold;">₦<%= Number(stats.tiktokRevenue).toLocaleString() %></div>
                <span class="form-hint">$70 USD/day model</span>
              </div>

              <div style="padding: 15px; background: #f8fafc; border-radius: 8px; border-left: 4px solid #E1306C;">
                <h4 style="margin: 0 0 5px 0;">📸 Instagram & Meta</h4>
                <div style="font-size: 20px; font-weight: bold;">₦<%= Number(stats.instagramRevenue).toLocaleString() %></div>
                <span class="form-hint">₦50K–₦500K tiers</span>
              </div>

              <div style="padding: 15px; background: #f8fafc; border-radius: 8px; border-left: 4px solid #4285F4;">
                <h4 style="margin: 0 0 5px 0;">🔍 Google Ads & YouTube</h4>
                <div style="font-size: 20px; font-weight: bold;">₦<%= Number(stats.googleRevenue).toLocaleString() %></div>
                <span class="form-hint">₦50K–₦500K tiers</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Recent Campaigns Table -->
        <div class="card" style="margin-bottom: 30px;">
          <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0;">Recent Campaigns (Last 10)</h3>
            <a href="/admin/campaigns" class="btn btn-outline btn-sm">View All Campaigns &rarr;</a>
          </div>
          <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
              <table class="table" style="margin: 0;">
                <thead>
                  <tr>
                    <th>Campaign ID</th>
                    <th>Business</th>
                    <th>Platforms</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentCampaigns && recentCampaigns.length > 0) { %>
                    <% recentCampaigns.forEach(function(c) { %>
                      <tr>
                        <td><code><%= c.campaignId %></code></td>
                        <td><strong><%= c.user ? c.user.businessName : 'Unknown' %></strong></td>
                        <td>
                          <% if (c.platforms) { %>
                            <% c.platforms.forEach(function(p) { %>
                              <span class="badge badge-gray" style="font-size: 11px;"><%= p.platform %></span>
                            <% }); %>
                          <% } %>
                        </td>
                        <td>₦<%= Number(c.totalAmount).toLocaleString() %></td>
                        <td>
                          <span class="badge badge-primary"><%= c.status %></span>
                        </td>
                        <td style="font-size: 12px;"><%= new Date(c.createdAt).toLocaleDateString('en-GB') %></td>
                        <td>
                          <a href="/admin/campaigns/<%= c.campaignId %>" class="btn btn-outline btn-sm">Manage</a>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr><td colspan="7" style="text-align: center; padding: 20px;">No campaigns logged yet.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Recent Payments Table -->
        <div class="card">
          <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0;">Recent Payments</h3>
            <a href="/admin/payments" class="btn btn-outline btn-sm">View All Transactions &rarr;</a>
          </div>
          <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
              <table class="table" style="margin: 0;">
                <thead>
                  <tr>
                    <th>Reference</th>
                    <th>Business</th>
                    <th>Campaign ID</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentPayments && recentPayments.length > 0) { %>
                    <% recentPayments.forEach(function(p) { %>
                      <tr>
                        <td><code><%= p.reference %></code></td>
                        <td><%= p.user ? p.user.businessName : 'Unknown' %></td>
                        <td><%= p.campaign ? p.campaign.campaignId : 'N/A' %></td>
                        <td><strong>₦<%= Number(p.amount).toLocaleString() %></strong></td>
                        <td>
                          <span class="badge <%= p.status === 'success' ? 'badge-success' : 'badge-warning' %>"><%= p.status %></span>
                        </td>
                        <td style="font-size: 12px;"><%= new Date(p.createdAt).toLocaleString('en-GB') %></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr><td colspan="6" style="text-align: center; padding: 20px;">No payment transactions recorded.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>

