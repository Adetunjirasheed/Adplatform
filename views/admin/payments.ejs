<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Payment Transactions | AdPlatform Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <div class="admin-layout">
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-brand">
        <span class="brand-accent">Ad</span>Platform <span class="badge badge-primary" style="font-size: 10px;">Admin</span>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin" class="nav-item">📊 Dashboard</a>
        <a href="/admin/users" class="nav-item">👥 Users</a>
        <a href="/admin/campaigns" class="nav-item">📢 Campaigns</a>
        <a href="/admin/payments" class="nav-item active">💳 Payments</a>
        <a href="/admin/settings" class="nav-item">⚙️ Settings</a>
        <a href="/admin/support" class="nav-item">🎧 Support Desk</a>
        <hr style="border: 0; border-top: 1px solid #334155; margin: 15px 0;">
        <a href="/dashboard" class="nav-item">👁️ Client View</a>
        <a href="/auth/logout" class="nav-item" style="color: #ef4444;">🚪 Logout</a>
      </nav>
    </aside>

    <main class="admin-main">
      <header class="admin-topbar">
        <div style="display: flex; align-items: center; gap: 15px;">
          <button class="btn btn-outline btn-sm admin-toggle-sidebar" id="sidebarToggleBtn">☰</button>
          <h2 style="margin: 0; font-size: 20px;">Financial Settlements & Logs</h2>
        </div>
      </header>

      <%- include('../partials/flash') %>

      <div class="admin-content-inner">
        <!-- Revenue Summary Header -->
        <div class="card" style="margin-bottom: 25px;">
          <div class="card-body" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
            <div>
              <div class="stat-card-title">Total Verified Settlements</div>
              <div style="font-size: 28px; font-weight: bold; color: var(--color-primary);">
                ₦<%= Number(totalRevenue).toLocaleString() %>
              </div>
            </div>

            <form action="/admin/payments" method="GET" style="display: flex; gap: 10px; flex-wrap: wrap;">
              <input type="text" name="search" class="form-control" placeholder="Search reference..." value="<%= search %>" style="width: 200px;">
              <select name="status" class="form-control">
                <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>All Statuses</option>
                <option value="success" <%= statusFilter === 'success' ? 'selected' : '' %>>Success</option>
                <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="failed" <%= statusFilter === 'failed' ? 'selected' : '' %>>Failed</option>
              </select>
              <button type="submit" class="btn btn-primary">Filter</button>
              <% if (search || statusFilter !== 'all') { %>
                <a href="/admin/payments" class="btn btn-outline">Reset</a>
              <% } %>
            </form>
          </div>
        </div>

        <!-- Payments Table -->
        <div class="card">
          <div class="card-header">
            <h3>Settlement Records (<%= payments.length %>)</h3>
          </div>
          <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
              <table class="table" style="margin: 0;">
                <thead>
                  <tr>
                    <th>Reference</th>
                    <th>Business</th>
                    <th>Campaign</th>
                    <th>Amount (₦)</th>
                    <th>Gateway</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Verified</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (payments && payments.length > 0) { %>
                    <% payments.forEach(function(pmt) { %>
                      <tr>
                        <td><code><%= pmt.reference %></code></td>
                        <td><strong><%= pmt.user ? pmt.user.businessName : 'Unknown' %></strong></td>
                        <td>
                          <% if (pmt.campaign) { %>
                            <a href="/admin/campaigns/<%= pmt.campaign.campaignId %>">
                              <%= pmt.campaign.campaignId %>
                            </a>
                          <% } else { %>N/A<% } %>
                        </td>
                        <td><strong>₦<%= Number(pmt.amount).toLocaleString() %></strong></td>
                        <td><span class="badge badge-gray"><%= pmt.gateway %></span></td>
                        <td>
                          <span class="badge <%= pmt.status === 'success' ? 'badge-success' : (pmt.status === 'failed' ? 'badge-danger' : 'badge-warning') %>">
                            <%= pmt.status.toUpperCase() %>
                          </span>
                        </td>
                        <td style="font-size: 12px;"><%= new Date(pmt.createdAt).toLocaleDateString('en-GB') %></td>
                        <td style="font-size: 12px;"><%= pmt.verifiedAt ? new Date(pmt.verifiedAt).toLocaleTimeString('en-GB') : '—' %></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr><td colspan="8" style="text-align: center; padding: 30px;">No transaction records found.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>

