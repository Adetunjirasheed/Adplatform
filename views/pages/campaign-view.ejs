<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= campaign.title %> | Campaign Showcase</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <% if (typeof demoMode !== 'undefined' && demoMode) { %>
    <div class="demo-banner">⚠️ DEMO CAMPAIGN — NOT SUBMITTED TO AD PLATFORM. Simulated preview.</div>
  <% } %>
  <%- include('../partials/flash') %>

  <main class="container page-container" style="padding: 40px 20px; max-width: 900px;">
    <!-- Back Navigation -->
    <div style="margin-bottom: 20px;">
      <a href="/dashboard" class="btn btn-outline btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
        &larr; Back to Dashboard
      </a>
    </div>

    <!-- Campaign Header Banner -->
    <div class="card" style="margin-bottom: 30px;">
      <div class="card-body">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 15px;">
          <div>
            <span class="badge badge-gray" style="font-size: 13px; margin-bottom: 8px;"><%= campaign.campaignId %></span>
            <h1 style="margin: 5px 0 10px 0; font-size: 28px;"><%= campaign.title %></h1>
            <p style="color: var(--color-muted); margin: 0;">
              Advertiser: <strong><%= campaign.user ? campaign.user.businessName : 'Verified Business' %></strong>
            </p>
          </div>

          <div style="text-align: right;">
            <% 
              let statusClass = 'badge-gray';
              if (campaign.status === 'Running') statusClass = 'badge-success';
              else if (campaign.status === 'Approved' || campaign.status === 'Scheduled') statusClass = 'badge-primary';
              else if (campaign.status === 'Payment Confirmed') statusClass = 'badge-info';
              else if (campaign.status === 'Awaiting Payment' || campaign.status === 'Under Review') statusClass = 'badge-warning';
              else if (campaign.status === 'Rejected') statusClass = 'badge-danger';
            %>
            <span class="badge <%= statusClass %>" style="font-size: 15px; padding: 8px 16px;">
              ● <%= campaign.status %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Media Showcase -->
    <div class="card" style="margin-bottom: 30px;">
      <div class="card-header">
        <h3>Creative Asset Showcase</h3>
      </div>
      <div class="card-body text-center">
        <% 
          const video = campaign.media ? campaign.media.find(m => m.fileType === 'video') : null;
          const image = campaign.media ? campaign.media.find(m => m.fileType === 'image') : null;
        %>

        <% if (video) { %>
          <div style="max-width: 650px; margin: 0 auto 20px auto; background: #000; border-radius: 8px; overflow: hidden;">
            <video controls style="width: 100%; max-height: 480px; display: block;" src="<%= video.filePath %>">
              Your browser does not support the video tag.
            </video>
          </div>
          <p class="form-hint">Advertisement Video: <%= video.originalName %></p>
        <% } %>

        <% if (image) { %>
          <div style="max-width: 600px; margin: 20px auto; border-radius: 8px; overflow: hidden; border: 1px solid var(--color-border);">
            <img src="<%= image.filePath %>" alt="Campaign Visual" style="width: 100%; height: auto; display: block;">
          </div>
          <p class="form-hint">Advertisement Creative Image: <%= image.originalName %></p>
        <% } %>

        <% if (!video && !image) { %>
          <div style="padding: 40px; background: #f8fafc; border-radius: 8px; color: var(--color-muted);">
            <span>📁</span> No public preview files attached.
          </div>
        <% } %>
      </div>
    </div>

    <!-- Campaign Details Grid -->
    <div class="card" style="margin-bottom: 30px;">
      <div class="card-header">
        <h3>Campaign Information</h3>
      </div>
      <div class="card-body">
        <% if (campaign.description) { %>
          <div style="margin-bottom: 20px;">
            <label class="form-label" style="color: var(--color-muted);">Description</label>
            <p style="margin: 0; line-height: 1.6;"><%= campaign.description %></p>
          </div>
        <% } %>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; padding-top: 15px; border-top: 1px solid var(--color-border);">
          <div>
            <label class="form-label" style="color: var(--color-muted);">Selected Ad Platforms</label>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <% if (campaign.platforms && campaign.platforms.length > 0) { %>
                <% campaign.platforms.forEach(function(plat) { %>
                  <span class="badge badge-primary" style="text-transform: capitalize;">
                    <%= plat.platform === 'tiktok' ? 'TikTok Ads' : (plat.platform === 'instagram' ? 'Meta / Instagram' : 'Google Ads') %>
                  </span>
                <% }); %>
              <% } else { %>
                <span class="badge badge-gray">General Network</span>
              <% } %>
            </div>
          </div>

          <div>
            <label class="form-label" style="color: var(--color-muted);">Schedule Duration</label>
            <p style="margin: 0; font-weight: 500;">
              <%= campaign.startDate ? campaign.startDate : 'Immediate' %>
              <% if (campaign.endDate) { %> — <%= campaign.endDate %><% } %>
            </p>
          </div>

          <div>
            <label class="form-label" style="color: var(--color-muted);">Target Geo</label>
            <p style="margin: 0; font-weight: 500;"><%= campaign.targetLocation || 'All Nigeria' %></p>
          </div>

          <% if (campaign.websiteUrl) { %>
            <div>
              <label class="form-label" style="color: var(--color-muted);">Destination Landing Page</label>
              <p style="margin: 0;">
                <a href="<%= campaign.websiteUrl %>" target="_blank" rel="noopener noreferrer" style="color: var(--color-primary); word-break: break-all;">
                  Visit Destination &nearr;
                </a>
              </p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Share Link Card -->
    <div class="card">
      <div class="card-body" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
        <div>
          <h4 style="margin: 0 0 5px 0;">Shareable Campaign Link</h4>
          <p style="margin: 0; font-size: 13px; color: var(--color-muted);">Share this secure verification page with team members or partners.</p>
        </div>
        <div style="display: flex; gap: 10px;">
          <input type="text" id="shareUrlInput" class="form-control" readonly value="" style="min-width: 250px; font-size: 13px;">
          <button type="button" class="btn btn-outline" id="copyShareBtn">Copy Link</button>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const shareInput = document.getElementById('shareUrlInput');
      const copyBtn = document.getElementById('copyShareBtn');
      if (shareInput) {
        shareInput.value = window.location.href;
      }
      if (copyBtn && shareInput) {
        copyBtn.addEventListener('click', () => {
          shareInput.select();
          navigator.clipboard.writeText(shareInput.value);
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = 'Copy Link'; }, 2000);
        });
      }
    });
  </script>
</body>
</html>

