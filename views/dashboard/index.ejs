<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Customer Dashboard | AdPlatform</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <% if (typeof demoMode !== 'undefined' && demoMode) { %>
    <div class="demo-banner">⚠️ DEMO MODE ACTIVE — No real payments or official platform API deployments occur.</div>
  <% } %>
  <%- include('../partials/flash') %>

  <main class="container page-container" style="padding: 30px 20px;">
    <!-- Welcome Header -->
    <div class="dashboard-header-banner card" style="margin-bottom: 25px;">
      <div class="card-body" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
        <div>
          <h1 style="margin: 0 0 5px 0; font-size: 26px;">Welcome back, <%= user.fullName %>!</h1>
          <p style="margin: 0; color: var(--color-muted);">
            Business: <strong><%= user.businessName %></strong> &bull; Email: <strong><%= user.businessEmail %></strong>
          </p>
        </div>
        <div>
          <a href="/campaigns/create" class="btn btn-primary btn-lg">+ Create New Campaign</a>
        </div>
      </div>
    </div>

    <!-- Stats Cards Grid -->
    <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;">
      <div class="card stat-card">
        <div class="card-body">
          <div class="stat-card-title">Total Campaigns</div>
          <div class="stat-card-value"><%= stats.total %></div>
          <div class="stat-card-hint">All campaigns created</div>
        </div>
      </div>

      <div class="card stat-card border-green">
        <div class="card-body">
          <div class="stat-card-title" style="color: var(--color-success);">Running / Live</div>
          <div class="stat-card-value" style="color: var(--color-success);"><%= stats.active %></div>
          <div class="stat-card-hint">Actively serving ads</div>
        </div>
      </div>

      <div class="card stat-card border-orange">
        <div class="card-body">
          <div class="stat-card-title" style="color: var(--color-warning);">Pending / In-Review</div>
          <div class="stat-card-value" style="color: var(--color-warning);"><%= stats.pending %></div>
          <div class="stat-card-hint">Awaiting payment or review</div>
        </div>
      </div>

      <div class="card stat-card border-blue">
        <div class="card-body">
          <div class="stat-card-title" style="color: var(--color-primary);">Completed</div>
          <div class="stat-card-value" style="color: var(--color-primary);"><%= stats.completed %></div>
          <div class="stat-card-hint">Past ad schedules</div>
        </div>
      </div>
    </div>

    <!-- Main Content Layout -->
    <div style="display: grid; grid-template-columns: 2.8fr 1.2fr; gap: 30px; align-items: flex-start;">
      <!-- Campaigns List Section -->
      <div class="card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
          <h3 style="margin: 0;">My Advertising Campaigns</h3>
          <span style="font-size: 13px; color: var(--color-muted);"><%= campaigns.length %> Records</span>
        </div>

        <div class="card-body" style="padding: 0;">
          <% if (campaigns && campaigns.length > 0) { %>
            <div class="table-responsive">
              <table class="table" style="margin: 0;">
                <thead>
                  <tr>
                    <th>Campaign ID</th>
                    <th>Title & Platforms</th>
                    <th>Total (₦)</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% campaigns.forEach(function(camp) { %>
                    <tr>
                      <td>
                        <a href="/campaigns/<%= camp.campaignId %>" style="font-weight: 600; color: var(--color-primary);">
                          <%= camp.campaignId %>
                        </a>
                      </td>
                      <td>
                        <div style="font-weight: 500;"><%= camp.title %></div>
                        <div style="display: flex; gap: 4px; margin-top: 4px; flex-wrap: wrap;">
                          <% if (camp.platforms && camp.platforms.length > 0) { %>
                            <% camp.platforms.forEach(function(p) { %>
                              <span class="badge badge-gray" style="font-size: 11px; padding: 2px 6px;">
                                <%= p.platform === 'tiktok' ? 'TikTok' : (p.platform === 'instagram' ? 'Meta' : 'Google') %>
                              </span>
                            <% }); %>
                          <% } %>
                        </div>
                      </td>
                      <td>
                        <strong>₦<%= Number(camp.totalAmount).toLocaleString() %></strong>
                      </td>
                      <td>
                        <% 
                          let statusClass = 'badge-gray';
                          if (camp.status === 'Running') statusClass = 'badge-success';
                          else if (camp.status === 'Approved' || camp.status === 'Scheduled') statusClass = 'badge-primary';
                          else if (camp.status === 'Payment Confirmed') statusClass = 'badge-info';
                          else if (camp.status === 'Awaiting Payment' || camp.status === 'Under Review') statusClass = 'badge-warning';
                          else if (camp.status === 'Rejected') statusClass = 'badge-danger';
                        %>
                        <span class="badge <%= statusClass %>">
                          <%= camp.status %>
                        </span>
                      </td>
                      <td style="font-size: 12px; color: var(--color-muted);">
                        <%= new Date(camp.createdAt).toLocaleDateString('en-GB') %>
                      </td>
                      <td>
                        <div style="display: flex; gap: 6px;">
                          <a href="/campaigns/<%= camp.campaignId %>" class="btn btn-outline btn-sm">View</a>
                          <% if (camp.status === 'Awaiting Payment') { %>
                            <a href="/campaigns/<%= camp.campaignId %>/payment" class="btn btn-primary btn-sm">Pay Now</a>
                          <% } else if (['Payment Confirmed', 'Under Review', 'Approved', 'Scheduled', 'Running', 'Completed'].includes(camp.status)) { %>
                            <a href="/campaigns/<%= camp.campaignId %>/receipt" class="btn btn-outline btn-sm" title="View Receipt">Receipt</a>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div style="padding: 60px 20px; text-align: center;">
              <div style="font-size: 48px; margin-bottom: 15px;">📢</div>
              <h3>No campaigns created yet</h3>
              <p style="color: var(--color-muted); max-width: 400px; margin: 0 auto 20px auto;">
                Create your first advertisement campaign to promote your products across TikTok, Meta, or Google Ads in Nigerian Naira.
              </p>
              <a href="/campaigns/create" class="btn btn-primary">+ Create Your First Campaign</a>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right Column: Recent Notifications & Quick Links -->
      <div>
        <div class="card" style="margin-bottom: 25px;">
          <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h4 style="margin: 0; font-size: 16px;">Recent Notifications</h4>
            <a href="/dashboard/notifications" style="font-size: 12px; color: var(--color-primary);">View All</a>
          </div>
          <div class="card-body" style="padding: 10px 15px;">
            <% if (recentNotifications && recentNotifications.length > 0) { %>
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <% recentNotifications.forEach(function(notif) { %>
                  <div style="padding-bottom: 10px; border-bottom: 1px solid var(--color-border);">
                    <div style="font-weight: 600; font-size: 13px;"><%= notif.title %></div>
                    <div style="font-size: 12px; color: var(--color-muted); margin: 3px 0;"><%= notif.message %></div>
                    <div style="font-size: 11px; color: var(--color-muted);">
                      <%= new Date(notif.createdAt).toLocaleString('en-GB') %>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p style="font-size: 13px; color: var(--color-muted); text-align: center; margin: 15px 0;">
                No notifications yet.
              </p>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h4 style="margin: 0; font-size: 16px;">Advertiser Helpdesk</h4>
          </div>
          <div class="card-body" style="font-size: 13px;">
            <p>Need support or custom campaign targeting?</p>
            <a href="/support" class="btn btn-outline btn-block btn-sm" style="margin-top: 10px;">Contact Support Team</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>

